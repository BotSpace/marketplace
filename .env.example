# ============================================
# Environment Variables Configuration
# ============================================
# Bu fayl loyiha uchun kerakli barcha environment o'zgaruvchilarini o'z ichiga oladi.
# .env.example faylini nusxalab .env nomi bilan saqlang va qiymatlarni to'ldiring.
# ============================================

# ============================================
# Debug Configuration
# ============================================
# Debug rejimini yoqish/ochish uchun ishlatiladi.
# "true" - debug rejimi yoqilgan, "false" - o'chirilgan
DEBUG="true"

# ============================================
# API Configuration
# ============================================
# Asosiy API server URL manzili.
# Bu o'zgaruvchi client-side'da ham mavjud bo'ladi (NEXT_PUBLIC_ prefiksi tufayli).
NEXT_PUBLIC_API="https://"

# ============================================
# Service URLs
# ============================================
# Constructor servis URL manzili.
# Bot constructor servisiga ulanish uchun ishlatiladi.
CONSTRUCTOR_URL="http://"

# Sales servis URL manzili.
# Sales servisiga ulanish uchun ishlatiladi.
SALES_URL="http://example.com"

# Manager servis URL manzili.
# Manager servisiga ulanish uchun ishlatiladi.
ADMIN_PANEL="http://example.com"

# ============================================
# Authentication Configuration
# ============================================
# NextAuth secret key.
# Bu key session va tokenlarni shifrlash uchun ishlatiladi.
# Kamida 32 ta belgidan iborat bo'lishi kerak.
# Yaratish uchun: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ============================================
# Telegram Configuration
# ============================================
# Telegram bot token.
# BotFather'dan olingan bot token.
# @BotFather ga murojaat qiling va bot yarating.
TELEGRAM_BOT_TOKEN=""

# Telegram chat ID.
# Xabarlarni qabul qiluvchi chat/channel ID.
# Bu ID admin chat ID bo'lishi mumkin.
TELEGRAM_CHAT_ID=""
